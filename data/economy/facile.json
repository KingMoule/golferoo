  "paintGreenPerM2": 600,
  "paintTeePerM2": 400,
  "paintBunkerPerM2": 300,
  "paintWaterPerM2": 400,
  "paintPathPerM2": 200,
  "paintRoughPerM2": 20,
  "paintTreesPerM2": 100,
  "reliefPerM3": 200,
  "newHole": 200000,

