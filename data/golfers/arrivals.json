// Arrivées des golfeurs au pavillon (spec C15, lot 2). Les arrivées ont lieu tout au long de la journée, à taux constant, multiplié par l'attrait du club ; les journées s'enchaînent sans nuit.
{
  // Groupes par jour pour un attrait de 1 (9 trous ouverts, réputation de départ, météo qui ne gêne pas) ; calé au banc (critère 4 final : 3 à 5 départs par jour)
  "groupsPerDay": 4,

  // Poids des groupes de 1, 2, 3 et 4 golfeurs
  "groupSizeWeights": [10, 40, 10, 40],

  // File devant la porte, en groupes ; au-delà, le groupe repart (GroupTurnedAway)
  "queueCapacity": 8,

  // Groupes de visiteurs sur le parcours au plus, par trou du parcours (36 sur 18 trous, le plafond mesuré à C12) : au-delà, le groupe de tête de la file attend
  "maxGroupsPerHole": 2,

  // Facteur sur la marche des golfeurs IA (le vol de balle et le pro joué par le joueur gardent leur vitesse) : la marche fait environ la moitié de leur temps
  "aiWalkSpeedFactor": 2.25,

  // Cadence de lecture du vol de balle des golfeurs IA (au moins 1) : la trajectoire ne change pas, la balle la parcourt plus vite
  "aiFlightSpeedFactor": 1.5,

  // Attrait = trous × réputation × météo
  "holesReference": 9,
  "holesExponent": 0.5,
  "holesCap": 18,
  "reputationMinFactor": 0.7,
  "reputationMaxFactor": 1.3,
  "weatherFactors": [1, 0.9, 0.4, 0.1],

  // Réputation : moyenne glissante des sorties (1 bonne, 0 mauvaise)
  "reputationStart": 0.5,
  "reputationWeight": 0.1,

  // Vivier : part des places d'un groupe tentées avec un visiteur qui veut revenir, envie de départ, gain d'une bonne sortie, perte d'un refus
  "returnShare": 0.6,
  "returnThreshold": 0.6,
  "desireStart": 0.5,
  "desireGood": 0.15,
  "desireRefused": 0.3,

  // Niveau des nouveaux visiteurs (handicap)
  "handicapMin": 8,
  "handicapMax": 30,

  "firstNames": ["Alice", "Bruno", "Chloé", "David", "Émile", "Fanny", "Gabriel", "Hélène", "Ivan", "Jade", "Karim", "Léa", "Marc", "Nadia", "Olivier", "Pauline", "Quentin", "Rita", "Samuel", "Thérèse", "Ulysse", "Vera", "William", "Yasmine"]
}
