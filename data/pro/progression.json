{
  // Progression de votre pro (C25). Calibré au lot 4 par saisons simulées (ProSeasonTests) : l'habileté la plus travaillée finit la saison 1 au niveau 24 et atteint 50 après la dixième saison.
  // XP pour passer du niveau n au niveau n + 1 : costScale × (n + 1 + 300 × 2^((n + 1) / 7)) / 4.
  "costScale": 0.085,
  // XP d'entraînement au plus, par habileté et par année (remise à zéro au 1er avril).
  "trainingCapPerYear": 300,
  // Seuils de qualité : l'écart (en part de la distance visée D) où la qualité tombe à 0.
  "clubFraction": 0.15,
  "clubFloor": 0.05,
  "putterMeters": 1.0,
  "putterFraction": 0.2,
  "precisionFraction": 0.06,
  "dosageFraction": 0.08,
  "distanceFloor": 0.75,
  "fullForce": 0.9,
  "curveFraction": 1.0,
  // Jeu dans le vent : vent (m/s) à partir duquel le coup nourrit l'habileté, et vent qui donne la qualité pleine du club.
  "windMin": 3.0,
  "windFull": 10.0,
  // Lecture du green : écart latéral au trou où la qualité tombe à 0 (le plus grand de ces deux seuils), et pente minimale (m/m) qui compte.
  "greenMeters": 0.5,
  "greenFraction": 0.1,
  "greenMinSlope": 0.01,
  // Aperçu faussé au niveau 0 (nul au niveau 50) : force du vent (part), rotation du vent (rad), rotation de la pente lue (rad) et sa part.
  "windBiasForce": 0.5,
  "windBiasAngle": 0.6,
  "slopeBiasAngle": 0.7,
  "slopeBiasScale": 0.5,
  // Chip : écart type de l'abaissement au niveau 0 (comme 0,15 pour la courbure d'un draw), réduit par niveau comme la dispersion.
  "chipSigma": 0.15
}
