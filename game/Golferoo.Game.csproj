<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- Rendu et UI. Toute la simulation vit dans Golferoo.Sim. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Golferoo.Game</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Golferoo.Sim\Golferoo.Sim.csproj" />
  </ItemGroup>

  <!-- Source de vérité : data/holes/ à la racine. Copié dans game/data/ (ignoré par git) pour être dans res:// et exporté. -->
  <Target Name="CopierTrous" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <TrouSource Include="$(MSBuildProjectDirectory)\..\data\holes\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(TrouSource)" DestinationFolder="$(MSBuildProjectDirectory)\data\holes" SkipUnchangedFiles="true" />
  </Target>

</Project>
