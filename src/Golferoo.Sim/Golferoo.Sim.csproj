<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simulation pure : aucune référence à Godot ici (ADR 0001, critère 4 de C01). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Golferoo.Sim.Tests" />
    <!-- Paramètres de Facile (C14) : source de vérité dans data/economy/, embarqués pour le jeu exporté comme pour les tests. -->
    <EmbeddedResource Include="..\..\data\economy\facile.json" LogicalName="facile.json" />
    <!-- Progression du pro (C25) : source de vérité dans data/pro/. -->
    <EmbeddedResource Include="..\..\data\pro\progression.json" LogicalName="progression.json" />
    <!-- Pénalité de lie (C25 lot 2) : source de vérité dans data/shots/. -->
    <EmbeddedResource Include="..\..\data\shots\lie.json" LogicalName="lie.json" />
    <!-- Arrivées au pavillon (C15 lot 2) : source de vérité dans data/golfers/. -->
    <EmbeddedResource Include="..\..\data\golfers\arrivals.json" LogicalName="arrivals.json" />
  </ItemGroup>

</Project>
