<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simulation pure : aucune référence à Godot ici (ADR 0001, critère 4 de C01). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Golferoo.Sim.Tests" />
    <!-- Paramètres de Facile (C14) : source de vérité dans data/economy/, embarqués pour le jeu exporté comme pour les tests. -->
    <EmbeddedResource Include="..\..\data\economy\facile.json" LogicalName="facile.json" />
    <!-- Difficulté (C18) : source de vérité dans data/difficulty/. -->
    <EmbeddedResource Include="..\..\data\difficulty\facile.json" LogicalName="difficulty-facile.json" />
    <!-- Objectifs du club (C18) : source de vérité dans data/objectives/. -->
    <EmbeddedResource Include="..\..\data\objectives\objectives.json" LogicalName="objectives.json" />
    <!-- Progression du pro (C25) : source de vérité dans data/pro/. -->
    <EmbeddedResource Include="..\..\data\pro\progression.json" LogicalName="progression.json" />
    <!-- Pénalité de lie (C25 lot 2) : source de vérité dans data/shots/. -->
    <EmbeddedResource Include="..\..\data\shots\lie.json" LogicalName="lie.json" />
    <!-- Arrivées au pavillon (C15 lot 2) : source de vérité dans data/golfers/. -->
    <EmbeddedResource Include="..\..\data\golfers\arrivals.json" LogicalName="arrivals.json" />
    <!-- Bâtiments et aménagements (C17) : source de vérité dans data/buildings/. -->
    <EmbeddedResource Include="..\..\data\buildings\buildings.json" LogicalName="buildings.json" />
    <!-- Humeur (C16 lot 1) : source de vérité dans data/golfers/. -->
    <EmbeddedResource Include="..\..\data\golfers\mood.json" LogicalName="mood.json" />
    <!-- Adhésion (C16 lot 2) : source de vérité dans data/golfers/. -->
    <EmbeddedResource Include="..\..\data\golfers\membership.json" LogicalName="membership.json" />
  </ItemGroup>

</Project>
